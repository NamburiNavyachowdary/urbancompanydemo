@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Bootstrap Icons CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<div class="container py-5">

    <!-- Hero Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Home Services at Your Doorstep</h1>
        <p class="lead text-muted">Book trusted professionals for all your home needs</p>
    </div>

    <!-- Services Section -->
    <div class="row text-center g-4">

        <div class="col-md-3">
            <div class="card shadow-sm p-4">
                <i class="bi bi-scissors fs-1 text-primary"></i>
                <h5 class="mt-3">Salon for Women</h5>
                <p class="text-muted small">Beauty services at home</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-4">
                <i class="bi bi-person-badge fs-1 text-success"></i>
                <h5 class="mt-3">Salon for Men</h5>
                <p class="text-muted small">Haircuts & grooming</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-4">
                <i class="bi bi-tools fs-1 text-warning"></i>
                <h5 class="mt-3">Appliance Repair</h5>
                <p class="text-muted small">AC, fridge, washing machine</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-4">
                <i class="bi bi-lightning-charge fs-1 text-danger"></i>
                <h5 class="mt-3">Electrician</h5>
                <p class="text-muted small">Repair & installations</p>
            </div>
        </div>

    </div>

    <!-- Second Row -->
    <div class="row text-center g-4 mt-3">

        <div class="col-md-3">
            <div class="card shadow-sm p-4">
                <i class="bi bi-droplet fs-1 text-info"></i>
                <h5 class="mt-3">Plumbers</h5>
                <p class="text-muted small">Leak fixes & fittings</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-4">
                <i class="bi bi-broom fs-1 text-secondary"></i>
                <h5 class="mt-3">Cleaning</h5>
                <p class="text-muted small">Home deep cleaning</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-4">
                <i class="bi bi-house-door fs-1 text-dark"></i>
                <h5 class="mt-3">Home Painting</h5>
                <p class="text-muted small">Interior & exterior</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm p-4">
                <i class="bi bi-shield-check fs-1 text-primary"></i>
                <h5 class="mt-3">Pest Control</h5>
                <p class="text-muted small">Safe & effective solutions</p>
            </div>
        </div>

    </div>

    <!-- CTA Section -->
    <div class="text-center mt-5">
        <a class="btn btn-primary btn-lg px-4" href="#">Book a Service</a>
    </div>

</div>
